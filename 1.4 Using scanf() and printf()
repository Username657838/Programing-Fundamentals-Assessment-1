#include <stdio.h>
int main() {
    int quantity;
    float price;
    printf("Juancho and Friday Nov 21, 2026 \n");
    printf("Enter burger quantity: ");
    scanf("%d", &quantity);
    printf("Enter burger price: ");
    scanf("%f", &price);
    printf("Total cost: AED %.2f\n", quantity * price);
    return 0;
    /*Scanf identifies the amount given for qunatity and 
    price it store till the printf instruct to multiply 
    the final result*/
}
