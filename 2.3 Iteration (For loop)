#include <stdio.h>
int main() {
    int i;
    /*For loop repeats an instructions, i = 1 is the loop,
    i <= 4 is the amount, and i++ increases the value*/
    printf("Juancho and Friday Nov 21, 2026 \n");
    for (i = 1; i <= 4; i++) {
        printf("QuickBite menu item %d\n", i);
    }
    return 0;
}
