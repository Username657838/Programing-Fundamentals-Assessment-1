#include <stdio.h>
int main() {
    /*While loop repeats an instruction for a specific condition
    remains true, it stops if the condition is false, thus ending*/
    int choice = 1;
    while (choice != 0) {
        printf("Juancho and Friday Nov 21, 2026 \n");
        printf("Enter 0 to finish ordering.\n");
        printf("Enter 1 to continue ordering.\n");
        scanf("%d", &choice);
    }
    printf("Order finished!\n");
    return 0;
}
