#include <stdio.h>
int main() {
    float subtotal = 80.00;
    float discount;
    float vat;
    float total;
    /*Applying float to a string will
    also affect the value using Float*/
    discount = subtotal * 0.10;
    vat = (subtotal - discount) * 0.05;
    total = subtotal - discount + vat;
    /*Giving a string new value used by the previous value and change
    it, will affect the new string such as discount, vat, and total*/
    printf("Juancho and Friday Nov 21, 2026 \n");
    printf("Subtotal: AED %.2f\n", subtotal);
    printf("Discount: AED %.2f\n", discount);
    printf("VAT: AED %.2f\n", vat);
    printf("Final total: AED %.2f\n", total);
    return 0;
}
