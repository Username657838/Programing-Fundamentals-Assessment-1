#include <stdio.h>
int main() {
    float subtotal = 80.00;
    float discount = 0;
    printf("Juancho and Friday Nov 21, 2026 \n");
    /*if statement, is a decision where it can be set
    on the given correspondingly*/
    if (subtotal >= 60) {
        discount = subtotal * 0.10;
        printf("You qualify for a 10%% discount!\n");
    }
    /*else statement, is a decision were otherwise 
    the given prints out an alternative output*/
    else {
        printf("No discount available.\n");
    }
    printf("Discount: AED %.2f\n", discount);
    return 0;
}
